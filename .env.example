# ── Telegram ──────────────────────────────────────────────────────────────────
# Get a bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID (admin). Get it from @userinfobot.
# This user can approve/deny new registrations and is auto-registered on startup.
TELEGRAM_CHAT_ID=

# ── VOLP credentials (admin only — used for backward-compat auto-registration) ─
# If set, the admin is auto-approved on startup so they don't need to /start.
VOLP_USERNAME=
VOLP_PASSWORD=

# ── OpenRouter (optional global fallback) ─────────────────────────────────────
# Free-tier key from https://openrouter.ai  — used when a user hasn't set their own key.
OPENROUTER_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway: mount a volume at /data and set this to /data/state.db
STATE_DB_PATH=/data/state.db

# ── VOLP settings ─────────────────────────────────────────────────────────────
VOLP_BASE_URL=https://classroom.volp.in
VOLP_LOGIN_URL=https://classroom.volp.in/login
VOLP_START_URL=https://classroom.volp.in/learner/my-courses

# Timezone offset of VOLP's due-date display (IST = 330 minutes ahead of UTC)
VOLP_TZ_OFFSET_MINUTES=330

# How many courses to scan per user per run
SCAN_MAX_COURSES=20

# Number of retry attempts if a scan fails
SCAN_RETRIES=2

# How often to scan (minutes)
CHECK_INTERVAL_MINUTES=10

# Run Playwright in headless mode (must be true on Railway/Docker)
HEADLESS=true
